# ShipGate — StudioNet frontend configuration
VITE_NETWORK=studionet
VITE_CHAIN_ID=61999
VITE_STUDIO_RPC=https://studio.genlayer.com/api

# Deployed ShipGate contract address on StudioNet (set after `npm run deploy`)
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Deploy/seed keys are read from your shell environment, never committed:
#   source ~/.genlayer/env.sh   (exports GENLAYER_PRIVATE_KEY, _2, _3, …)
# Never place a private key in any VITE_* variable — it ships in the public bundle.
